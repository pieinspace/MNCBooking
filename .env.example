VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only. Never prefix this with VITE_ or expose it to browser code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY

# Used only by the explicit demo account seed command.
MNC_DEMO_ADMIN_PASSWORD=replace-with-a-strong-password
MNC_DEMO_USER_PASSWORD=replace-with-a-strong-password
